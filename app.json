{
  "expo": {
    "name": "Kozé",
    "slug": "koze",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "koze",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.playzkool.koze",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "fr"
        ]
      }
    },
    "android": {
      "package": "com.playzkool.koze",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1F6FEB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6FEB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kozé accède à vos photos pour créer des pictogrammes personnalisés. Les photos restent sur cet appareil.",
          "cameraPermission": "Kozé utilise l'appareil photo pour créer des pictogrammes personnalisés. Les photos restent sur cet appareil.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be27fc22-2d1b-4df8-8024-0850f3975796"
      }
    },
    "owner": "sebskool",
    "updates": {
      "url": "https://u.expo.dev/be27fc22-2d1b-4df8-8024-0850f3975796"
    }
  }
}
